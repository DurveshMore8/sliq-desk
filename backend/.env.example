# Only needed when running the backend outside Docker (npm run dev in backend/).
# Copy to backend/.env and fill in. Docker Compose does not use this file.
PORT=4000
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# MongoDB: a local server or Atlas (URL-encode special characters in the password)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sliqdesk?retryWrites=true&w=majority

# Email: Gmail with an app password, or a local Mailpit (host localhost, port 1025, no auth)
MAIL_FROM="SliqDesk <your.address@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password

SLA_MINUTES=2
SLA_CHECK_INTERVAL_SECONDS=10
SEED_ON_START=true