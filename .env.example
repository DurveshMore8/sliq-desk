# Ports
BACKEND_PORT=4000
FRONTEND_PORT=3000
MAILPIT_UI_PORT=8025

# General
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000

# Database (MongoDB runs without auth inside the compose network; local dev only)
MONGO_DB=sliqdesk

# Email (Mailpit catches all mail locally; inbox at http://localhost:8025)
MAIL_FROM=SliqDesk <no-reply@sliqdesk.local>

# SLA: minutes before a high/urgent ticket with no staff reply is flagged overdue
SLA_MINUTES=2
# How often the background check looks for overdue tickets
SLA_CHECK_INTERVAL_SECONDS=10

