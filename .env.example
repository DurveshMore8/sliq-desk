# Host ports. If you change one, update the matching URL below too.
FRONTEND_PORT=3000
BACKEND_PORT=4000
MAILPIT_UI_PORT=8025

# Public URLs. Open the app at http://localhost:3000 (not 127.0.0.1): the API only accepts
# requests from CORS_ORIGIN, and the session cookie is bound to the host name.
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000

# Database: a local MongoDB container is used by default.
# To use MongoDB Atlas instead, uncomment and fill in (URL-encode special characters in the password):
# DOCKER_MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sliqdesk?retryWrites=true&w=majority

# Email: every message is caught by Mailpit (inbox at http://localhost:8025).
# To send real email instead, set these (for example Gmail with an app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=your-16-char-app-password
MAIL_FROM=SliqDesk <no-reply@sliqdesk.local>

# SLA: minutes before a high/urgent ticket with no staff reply is flagged overdue,
# and how often (seconds) the background check runs.
SLA_MINUTES=2
SLA_CHECK_INTERVAL_SECONDS=10

# Create demo organizations and users on startup (idempotent). Set to false to disable.
SEED_ON_START=true